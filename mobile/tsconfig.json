{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./*"],
      "@poup/shared": ["../packages/shared/src/index.ts"],
      "@poup/shared/*": ["../packages/shared/src/*"],
      "react-native": ["./node_modules/react-native"],
      "lucide-react-native": ["./node_modules/lucide-react-native"],
      "@react-native-google-signin/google-signin": ["./node_modules/@react-native-google-signin/google-signin"],
      "@react-native-async-storage/async-storage": ["./node_modules/@react-native-async-storage/async-storage"],
      "expo-apple-authentication": ["./node_modules/expo-apple-authentication"],
      "expo-location": ["./node_modules/expo-location"],
      "expo-notifications": ["./node_modules/expo-notifications"],
      "expo-device": ["./node_modules/expo-device"],
      "expo-secure-store": ["./node_modules/expo-secure-store"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "legacy"
  ]
}
