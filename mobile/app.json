{
  "expo": {
    "name": "Poup",
    "slug": "poup",
    "owner": "lucasgalhardo",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "poup",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.poup.consumer",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "deploymentTarget": "13.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para mostrar lojas e ofertas perto de você.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.poup.consumer",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDBnPZFEfcNAu9XgCKkvuOaJpGo3ZiRml8"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Precisamos da sua localização para mostrar lojas e ofertas perto de você."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#16a34a"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Acesse suas fotos para selecionar imagens de encartes.",
          "cameraPermission": "Acesse sua câmera para fotografar encartes, escanear código de barras e notas fiscais."
        }
      ],
      "expo-dev-client",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.824881461560-qqgqu622abjoh6tk6iaui36ru6mhmp12"
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Acesse sua câmera para fotografar encartes, escanear código de barras e notas fiscais.",
          "enableCodeScanner": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "AppCheckCore", "modular_headers": true },
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ec2af93-55e6-420f-b35b-89c7d8ea3021"
      }
    }
  }
}
